<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="HTools.App.Views.SettingsView">
    <StackPanel Spacing="20" Margin="4" MaxWidth="480">
        <TextBlock Text="{Binding Title}" Classes="pageTitle" Margin="0" />

        <StackPanel Spacing="6">
            <TextBlock Text="{Binding LanguageLabel}" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding Languages}"
                      SelectedItem="{Binding SelectedLanguage}"
                      HorizontalAlignment="Left" MinWidth="220">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding NativeName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ToggleSwitch IsChecked="{Binding IsStartWithWindowsEnabled}" />
                <TextBlock Text="{Binding StartWithWindowsLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding StartWithWindowsHint}" Classes="hint" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <ToggleButton Classes="themeSwitch" IsChecked="{Binding IsDarkThemeEnabled}" />
            <TextBlock Text="{Binding DarkThemeLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="{Binding MinToolCardWidthLabel}" FontWeight="SemiBold" />
            <NumericUpDown Value="{Binding MinToolCardWidth}"
                           Minimum="160" Maximum="360" Increment="10"
                           FormatString="0" Width="120" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding MinToolCardWidthHint}" Classes="hint" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="{Binding AboutLabel}" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding AuthorLabel}" Opacity="0.7" Width="70" />
                <Button Content="{Binding AuthorEmailText}"
                        Command="{Binding OpenEmailCommand}"
                        Classes="link" Padding="0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding WebsiteLabel}" Opacity="0.7" Width="70" />
                <Button Content="{Binding WebsiteText}"
                        Command="{Binding OpenWebsiteCommand}"
                        Classes="link" Padding="0" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
