<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HTools.App.Views.HotkeyCaptureWindow"
        Width="380" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Hotkey">
    <StackPanel Margin="20" Spacing="14">
        <TextBlock x:Name="InstructionText" TextWrapping="Wrap" />
        <Border Background="{DynamicResource SystemChromeLowColor}" CornerRadius="6" Padding="10" HorizontalAlignment="Stretch">
            <TextBlock x:Name="CapturedText" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Text="…" />
        </Border>
        <TextBlock x:Name="ErrorText" Foreground="OrangeRed" TextWrapping="Wrap" IsVisible="False" FontSize="12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="ClearButton" Click="OnClearClick" />
            <Button x:Name="CancelButton" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
