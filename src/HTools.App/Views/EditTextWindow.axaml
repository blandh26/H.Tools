<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HTools.App.Views.EditTextWindow"
        Width="420" Height="320"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Edit">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <TextBlock x:Name="ContentLabel" Grid.Row="0" Margin="0,0,0,8" FontWeight="SemiBold" />
        <TextBox x:Name="ContentTextBox"
                 Grid.Row="1"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" Spacing="8">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClick" />
            <Button x:Name="SaveButton" Content="Save" Click="OnSaveClick" Classes="accent" />
        </StackPanel>
    </Grid>
</Window>
