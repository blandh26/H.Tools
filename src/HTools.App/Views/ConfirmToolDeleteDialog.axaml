<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HTools.App.Views.ConfirmToolDeleteDialog"
        Title="确认删除" Width="380" Height="170"
        WindowStartupLocation="CenterOwner" CanResize="False">
    <Grid RowDefinitions="*,Auto" Margin="22">
        <TextBlock x:Name="PromptText" VerticalAlignment="Center" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="删除" Classes="accent" Click="OnConfirmClick" MinWidth="84" />
            <Button Content="取消" Click="OnCancelClick" MinWidth="84" />
        </StackPanel>
    </Grid>
</Window>
