<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HTools.App.Views.ConfirmToolDeleteDialog"
        Width="380" Height="170"
        WindowStartupLocation="CenterOwner" CanResize="False">
    <!-- Title, prompt and button text are assigned in code-behind from the localization service. -->
    <Grid RowDefinitions="*,Auto" Margin="22">
        <TextBlock x:Name="PromptText" VerticalAlignment="Center" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="ConfirmButton" Classes="accent" Click="OnConfirmClick" MinWidth="84" />
            <Button x:Name="CancelButton" Click="OnCancelClick" MinWidth="84" />
        </StackPanel>
    </Grid>
</Window>
