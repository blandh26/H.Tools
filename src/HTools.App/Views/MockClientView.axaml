<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
             x:Class="HTools.App.Views.MockClientView">
    <Grid Margin="4" ColumnDefinitions="240,12,*" RowDefinitions="Auto,*">
        <TextBlock Grid.ColumnSpan="3" Text="{Binding Title}" Classes="pageTitle" Margin="0,0,0,14" />
        <Border Grid.Row="1" Background="{DynamicResource SystemChromeLowColor}" CornerRadius="8" Padding="10">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="{Binding HistoryLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{Binding ClearHistoryLabel}" Command="{Binding ClearHistoryCommand}" />
                </Grid>
                <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="3" Margin="4">
                                <TextBlock Text="{Binding Method}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="8">
                <ComboBox ItemsSource="{Binding HttpMethods}" SelectedItem="{Binding ClientMethod}" />
                <TextBox Grid.Column="1" Text="{Binding ClientUrl}" PlaceholderText="{Binding UrlLabel}" />
                <Button Grid.Column="2" Content="{Binding SendLabel}" Command="{Binding SendCommand}" IsEnabled="{Binding !IsSending}" Classes="accent" MinWidth="100" />
            </Grid>
            <TabControl Grid.Row="1" Grid.RowSpan="2">
                <TabItem Header="{Binding ParamsHeadersTabLabel}">
                    <Grid Margin="8" RowDefinitions="Auto,*" RowSpacing="10">
                        <TextBlock Text="{Binding HeadersLabel}" FontWeight="SemiBold" />
                        <TextBox Grid.Row="1" Text="{Binding ClientHeaders}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                    </Grid>
                </TabItem>
                <TabItem Header="{Binding BodyLabel}">
                    <TextBox Margin="8" Text="{Binding ClientBody}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                </TabItem>
                <TabItem Header="{Binding ResponseLabel}">
                    <ScrollViewer Margin="8">
                        <TextBlock Text="{Binding ClientResponseText}" TextWrapping="Wrap" FontFamily="Consolas,monospace" />
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <TextBlock Grid.Row="3" Text="{Binding FooterText}" Opacity="0.55" FontSize="11" />
        </Grid>
    </Grid>
</UserControl>
