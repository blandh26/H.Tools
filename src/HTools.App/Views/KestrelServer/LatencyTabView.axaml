<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="460"
             x:Class="HTools.App.Views.KestrelServer.LatencyTabView">
    <StackPanel Spacing="12" Margin="4">
        <TextBlock Text="{Binding Title}" Classes="pageTitle" />
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding PortLabel}" Width="90" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding Port}" Minimum="1024" Maximum="65535" Width="140" FormatString="0" />
            <Button Content="{Binding StartLabel}" Command="{Binding ToggleCommand}" IsVisible="{Binding !IsRunning}" Classes="accent" />
            <Button Content="{Binding StopLabel}" Command="{Binding ToggleCommand}" IsVisible="{Binding IsRunning}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="模拟入口" Width="90" VerticalAlignment="Center" />
            <TextBox Text="{Binding AccessUrl}" IsReadOnly="True" Width="320" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding DelayMsLabel}" Width="90" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding DelayMs}" Minimum="0" Maximum="30000" Width="140" FormatString="0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding TargetUrlLabel}" Width="90" VerticalAlignment="Center" />
            <TextBox Text="{Binding TargetUrl}" Width="420" />
        </StackPanel>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource AppDangerBrush}" TextWrapping="Wrap" />
        <ListBox ItemsSource="{Binding RequestLog}" Height="180">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding ReceivedAt}" Opacity="0.5" FontSize="11" Width="140" />
                        <TextBlock Text="{Binding Method}" FontWeight="SemiBold" Width="60" />
                        <TextBlock Text="{Binding Path}" />
                        <TextBlock Text="{Binding ResponseStatusCode}" Opacity="0.6" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
