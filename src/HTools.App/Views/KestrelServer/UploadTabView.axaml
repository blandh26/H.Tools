<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="480"
             x:Class="HTools.App.Views.KestrelServer.UploadTabView">
    <StackPanel Spacing="12" Margin="4">
        <TextBlock Text="{Binding Title}" Classes="pageTitle" />
        <TabControl>
            <!-- 子页签 1：端口 / 目录 / 启停 / 已接收文件 -->
            <TabItem Header="{Binding ConfigTabLabel}">
                <StackPanel Spacing="12" Margin="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding PortLabel}" Width="90" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding Port}" Minimum="1024" Maximum="65535" Width="140" FormatString="0" />
                        <Button Content="{Binding StartLabel}" Command="{Binding ToggleCommand}" IsVisible="{Binding !IsRunning}" Classes="accent" />
                        <Button Content="{Binding StopLabel}" Command="{Binding ToggleCommand}" IsVisible="{Binding IsRunning}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{Binding UploadFolderLabel}" Width="90" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding UploadFolder}" IsReadOnly="True" />
                        <Button Grid.Column="2" Content="{Binding ChooseFolderLabel}" Click="OnChooseFolderClick" />
                    </Grid>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource AppDangerBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ReceivedFilesLabel}" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding ReceivedFiles}" Height="200" />
                </StackPanel>
            </TabItem>
            <!-- 子页签 2：访问地址 + 浏览器 / curl 使用说明 -->
            <TabItem Header="{Binding UsageTabLabel}">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="16" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding AccessUrlLabel}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding AccessUrl}" IsReadOnly="True" />
                        <TextBlock Text="{Binding HowToLabel}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding HowToText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CommandLineLabel}" FontWeight="SemiBold" />
                        <Border Background="{DynamicResource SystemChromeLowColor}" Padding="12" CornerRadius="6">
                            <TextBlock Text="{Binding UploadExample}" FontFamily="Consolas,monospace" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="{Binding RemoteHintText}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
