<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="640"
             x:Class="HTools.App.Views.KestrelServer.MockApiTabView"
             x:Name="Root">
    <DockPanel Margin="4">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <TextBlock Text="{Binding PortLabel}" Width="90" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding Port}" Minimum="1024" Maximum="65535" Width="140" FormatString="0" />
            <Button Content="{Binding StartLabel}" Command="{Binding ToggleCommand}" IsVisible="{Binding !IsRunning}" Classes="accent" />
            <Button Content="{Binding StopLabel}" Command="{Binding ToggleCommand}" IsVisible="{Binding IsRunning}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
            <TextBlock Text="{Binding RulesLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="{Binding AddRuleLabel}" Command="{Binding AddRuleCommand}" />
            <Button Content="{Binding ApplyLabel}" Command="{Binding ApplyRulesCommand}" />
        </StackPanel>

        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Rules}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SystemChromeLowColor}" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox Text="{Binding Method}" Width="70" />
                            <TextBox Text="{Binding Path}" Width="140" />
                            <NumericUpDown Value="{Binding StatusCode}" Width="110" FormatString="0" Minimum="100" Maximum="599" />
                            <TextBox Text="{Binding ContentType}" Width="130" />
                            <TextBox Text="{Binding Body}" Width="160" />
                            <Button Content="{Binding #Root.DataContext.RemoveRuleLabel}"
                                    Command="{Binding #Root.DataContext.RemoveRuleCommand}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
            <TextBlock Text="{Binding RequestLogLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="{Binding ClearLogLabel}" Command="{Binding ClearLogCommand}" />
        </StackPanel>
        <ListBox ItemsSource="{Binding RequestLog}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding ReceivedAt}" Opacity="0.5" FontSize="11" Width="140" />
                        <TextBlock Text="{Binding Method}" FontWeight="SemiBold" Width="60" />
                        <TextBlock Text="{Binding Path}" />
                        <TextBlock Text="{Binding ResponseStatusCode}" Opacity="0.6" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
