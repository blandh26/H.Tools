<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="640"
             x:Class="HTools.App.Views.KestrelServerView"
             x:Name="Root">
    <DockPanel Margin="4">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />

        <TabControl>
            <!-- 静态文件服务器 -->
            <TabItem Header="{Binding StaticFileTabLabel}">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding PortLabel}" Width="90" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding StaticFileTab.Port}" Minimum="1024" Maximum="65535" Width="140" FormatString="0" />
                        <Button Content="{Binding StartLabel}" Command="{Binding StaticFileTab.ToggleCommand}" IsVisible="{Binding !StaticFileTab.IsRunning}" Classes="accent" />
                        <Button Content="{Binding StopLabel}" Command="{Binding StaticFileTab.ToggleCommand}" IsVisible="{Binding StaticFileTab.IsRunning}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding RootFolderLabel}" Width="90" VerticalAlignment="Center" />
                        <TextBox Text="{Binding StaticFileTab.RootFolder}" Width="420" />
                    </StackPanel>
                    <TextBlock Text="{Binding StaticFileTab.ErrorMessage}" Foreground="Red" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <!-- Mock API -->
            <TabItem Header="{Binding MockApiTabLabel}">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                        <TextBlock Text="{Binding PortLabel}" Width="90" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding MockApiTab.Port}" Minimum="1024" Maximum="65535" Width="140" FormatString="0" />
                        <Button Content="{Binding StartLabel}" Command="{Binding MockApiTab.ToggleCommand}" IsVisible="{Binding !MockApiTab.IsRunning}" Classes="accent" />
                        <Button Content="{Binding StopLabel}" Command="{Binding MockApiTab.ToggleCommand}" IsVisible="{Binding MockApiTab.IsRunning}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                        <TextBlock Text="{Binding RulesLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="{Binding AddRuleLabel}" Command="{Binding MockApiTab.AddRuleCommand}" />
                        <Button Content="{Binding ApplyLabel}" Command="{Binding MockApiTab.ApplyRulesCommand}" />
                    </StackPanel>

                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding MockApiTab.Rules}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SystemChromeLowColor}" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBox Text="{Binding Method}" Width="70" />
                                        <TextBox Text="{Binding Path}" Width="140" />
                                        <NumericUpDown Value="{Binding StatusCode}" Width="110" FormatString="0" Minimum="100" Maximum="599" />
                                        <TextBox Text="{Binding ContentType}" Width="130" />
                                        <TextBox Text="{Binding Body}" Width="160" />
                                        <Button Content="{Binding #Root.DataContext.RemoveRuleLabel}"
                                                Command="{Binding #Root.DataContext.MockApiTab.RemoveRuleCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                        <TextBlock Text="{Binding RequestLogLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="{Binding ClearLogLabel}" Command="{Binding MockApiTab.ClearLogCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding MockApiTab.RequestLog}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding ReceivedAt}" Opacity="0.5" FontSize="11" Width="140" />
                                    <TextBlock Text="{Binding Method}" FontWeight="SemiBold" Width="60" />
                                    <TextBlock Text="{Binding Path}" />
                                    <TextBlock Text="{Binding ResponseStatusCode}" Opacity="0.6" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Webhook 接收器 -->
            <TabItem Header="{Binding WebhookTabLabel}">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                        <TextBlock Text="{Binding PortLabel}" Width="90" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding WebhookTab.Port}" Minimum="1024" Maximum="65535" Width="140" FormatString="0" />
                        <Button Content="{Binding StartLabel}" Command="{Binding WebhookTab.ToggleCommand}" IsVisible="{Binding !WebhookTab.IsRunning}" Classes="accent" />
                        <Button Content="{Binding StopLabel}" Command="{Binding WebhookTab.ToggleCommand}" IsVisible="{Binding WebhookTab.IsRunning}" />
                        <Button Content="{Binding ClearLogLabel}" Command="{Binding WebhookTab.ClearLogCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding WebhookTab.RequestLog}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Margin="0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding ReceivedAt}" Opacity="0.5" FontSize="11" Width="140" />
                                        <TextBlock Text="{Binding Method}" FontWeight="SemiBold" Width="60" />
                                        <TextBlock Text="{Binding Path}" />
                                        <TextBlock Text="{Binding RemoteAddress}" Opacity="0.5" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Body}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" MaxHeight="60" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- 文件上传服务器 -->
            <TabItem Header="{Binding UploadTabLabel}">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding PortLabel}" Width="90" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding UploadTab.Port}" Minimum="1024" Maximum="65535" Width="140" FormatString="0" />
                        <Button Content="{Binding StartLabel}" Command="{Binding UploadTab.ToggleCommand}" IsVisible="{Binding !UploadTab.IsRunning}" Classes="accent" />
                        <Button Content="{Binding StopLabel}" Command="{Binding UploadTab.ToggleCommand}" IsVisible="{Binding UploadTab.IsRunning}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding UploadFolderLabel}" Width="90" VerticalAlignment="Center" />
                        <TextBox Text="{Binding UploadTab.UploadFolder}" Width="420" />
                    </StackPanel>
                    <TextBlock Text="{Binding UploadTab.ErrorMessage}" Foreground="Red" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ReceivedFilesLabel}" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding UploadTab.ReceivedFiles}" Height="200" />
                </StackPanel>
            </TabItem>

            <!-- 反向代理 -->
            <TabItem Header="{Binding ProxyTabLabel}">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding PortLabel}" Width="90" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding ProxyTab.Port}" Minimum="1024" Maximum="65535" Width="140" FormatString="0" />
                        <Button Content="{Binding StartLabel}" Command="{Binding ProxyTab.ToggleCommand}" IsVisible="{Binding !ProxyTab.IsRunning}" Classes="accent" />
                        <Button Content="{Binding StopLabel}" Command="{Binding ProxyTab.ToggleCommand}" IsVisible="{Binding ProxyTab.IsRunning}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding TargetUrlLabel}" Width="90" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ProxyTab.TargetUrl}" Width="420" />
                    </StackPanel>
                    <TextBlock Text="{Binding ProxyTab.ErrorMessage}" Foreground="Red" TextWrapping="Wrap" />
                    <ListBox ItemsSource="{Binding ProxyTab.RequestLog}" Height="220">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding ReceivedAt}" Opacity="0.5" FontSize="11" Width="140" />
                                    <TextBlock Text="{Binding Method}" FontWeight="SemiBold" Width="60" />
                                    <TextBlock Text="{Binding Path}" />
                                    <TextBlock Text="{Binding ResponseStatusCode}" Opacity="0.6" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </TabItem>

            <!-- 延迟模拟 -->
            <TabItem Header="{Binding LatencyTabLabel}">
                <StackPanel Spacing="12" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding PortLabel}" Width="90" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding LatencyTab.Port}" Minimum="1024" Maximum="65535" Width="140" FormatString="0" />
                        <Button Content="{Binding StartLabel}" Command="{Binding LatencyTab.ToggleCommand}" IsVisible="{Binding !LatencyTab.IsRunning}" Classes="accent" />
                        <Button Content="{Binding StopLabel}" Command="{Binding LatencyTab.ToggleCommand}" IsVisible="{Binding LatencyTab.IsRunning}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding DelayMsLabel}" Width="90" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding LatencyTab.DelayMs}" Minimum="0" Maximum="30000" Width="140" FormatString="0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding TargetUrlLabel}" Width="90" VerticalAlignment="Center" />
                        <TextBox Text="{Binding LatencyTab.TargetUrl}" Width="420" />
                    </StackPanel>
                    <TextBlock Text="{Binding LatencyTab.ErrorMessage}" Foreground="Red" TextWrapping="Wrap" />
                    <ListBox ItemsSource="{Binding LatencyTab.RequestLog}" Height="180">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding ReceivedAt}" Opacity="0.5" FontSize="11" Width="140" />
                                    <TextBlock Text="{Binding Method}" FontWeight="SemiBold" Width="60" />
                                    <TextBlock Text="{Binding Path}" />
                                    <TextBlock Text="{Binding ResponseStatusCode}" Opacity="0.6" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
