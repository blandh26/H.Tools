<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HTools.App.Views.CustomToolDialog"
        Width="500" Height="340"
        MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <!-- All visible text is assigned in code-behind (ApplyTexts) from the localization service. -->
    <Grid RowDefinitions="*,Auto" Margin="24">
        <StackPanel Spacing="14">
            <TextBlock x:Name="NameLabel" FontWeight="SemiBold" />
            <TextBox x:Name="NameBox" TextChanged="OnNameChanged" />

            <TextBlock x:Name="KindLabel" FontWeight="SemiBold" />
            <ComboBox x:Name="KindBox" SelectedIndex="0" SelectionChanged="OnKindChanged">
                <ComboBoxItem x:Name="ExeKindItem" Tag="exe" />
                <ComboBoxItem x:Name="UrlKindItem" Tag="url" />
            </ComboBox>

            <TextBlock x:Name="TargetLabel" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="TargetBox" LostFocus="OnTargetLostFocus" />
                <Button x:Name="BrowseButton" Grid.Column="1" Click="OnBrowseClick" />
            </Grid>
            <TextBlock x:Name="ValidationText" Foreground="{DynamicResource AppDangerBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Classes="accent" Click="OnSaveClick" MinWidth="88" />
            <Button x:Name="CancelButton" Click="OnCancelClick" MinWidth="88" />
        </StackPanel>
    </Grid>
</Window>
