<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HTools.App"
             x:Class="HTools.App.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Shared status/accent colors, reused for both the screenshot toolbar's SVG icons and
                 every "error"/"success" indicator elsewhere in the app, so they read as one consistent
                 palette instead of clashing hand-picked colors per screen. Mid-saturation tones (the
                 same family Tailwind CSS uses for its default palette) were chosen specifically because
                 they hold up on both light and dark backgrounds without needing per-theme variants. -->
            <Color x:Key="AppDangerColor">#EF4444</Color>
            <Color x:Key="AppWarningColor">#F59E0B</Color>
            <Color x:Key="AppSuccessColor">#22C55E</Color>
            <Color x:Key="AppInfoColor">#3B82F6</Color>
            <SolidColorBrush x:Key="AppDangerBrush" Color="{StaticResource AppDangerColor}" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="{StaticResource AppWarningColor}" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
            <SolidColorBrush x:Key="AppInfoBrush" Color="{StaticResource AppInfoColor}" />

            <!-- Unlike the accent colors above, a "warning callout box" background genuinely needs a
                 different value per theme — a dark amber-tinted panel that looks intentional on a dark
                 background would look like a rendering glitch sitting on a light one (this was previously
                 hardcoded to only the dark-theme value, e.g. in the clipboard/screenshot hotkey-conflict
                 warning boxes, so it looked wrong whenever the app ran in light mode). -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="AppWarningBackgroundColor">#FFF7E0</Color>
                    <Color x:Key="AppWarningBorderColor">#E0A800</Color>
                    <Color x:Key="AppWarningForegroundColor">#8A6100</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="AppWarningBackgroundColor">#332E1F</Color>
                    <Color x:Key="AppWarningBorderColor">#B8860B</Color>
                    <Color x:Key="AppWarningForegroundColor">#E0A800</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button.navItem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.navItem.selected">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
        </Style>

        <!-- Type scale: one place to tune "what a page title looks like" / "what a secondary hint looks
             like" instead of the same FontSize+FontWeight pair repeated inline on every page. -->
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <Style Selector="Grid.toolCardHost">
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="120" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style Selector="Button.toolCard">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <!-- Hover reads as "this card lifted up", not a color change — matches the reference app-center
             grid, whose cards only ever gain a drop shadow on hover, nothing else. Effect (not Border's
             BoxShadow) because this is set directly on the Button, which has no BoxShadow property of
             its own. -->
        <Style Selector="Button.toolCard:pointerover">
            <Setter Property="Effect">
                <DropShadowEffect OffsetX="0" OffsetY="4" BlurRadius="16" Color="Black" Opacity="0.25" />
            </Setter>
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
        </Style>

        <Style Selector="Button.hotkeyBadge">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.hotkeyBadge.copyBadge">
            <Setter Property="Background" Value="#5B5B5B" />
        </Style>

        <!-- Sidebar "pin to top" toggle — small icon button next to the app title, replacing the
             custom-title-bar version of this after that broke the window entirely (see git history). -->
        <Style Selector="ToggleButton.pinToggle">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.pinToggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemChromeMediumColor}" />
        </Style>
        <Style Selector="ToggleButton.pinToggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
        </Style>

        <!-- Sun/moon theme switch: a pill track with a circular thumb that shows a sun glyph on the
             left (light) or slides to the right and shows a moon glyph (dark). -->
        <Style Selector="ToggleButton.themeSwitch">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border Name="Track" CornerRadius="14" Background="#9CA3AF" />
                        <Border Name="Thumb" Width="24" Height="24" CornerRadius="12" Background="White"
                                HorizontalAlignment="Left" Margin="2,0,0,0">
                            <TextBlock Name="Glyph" Text="☀" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.themeSwitch:checked /template/ Border#Track">
            <Setter Property="Background" Value="#1E3A8A" />
        </Style>
        <Style Selector="ToggleButton.themeSwitch:checked /template/ Border#Thumb">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <Style Selector="ToggleButton.themeSwitch:checked /template/ TextBlock#Glyph">
            <Setter Property="Text" Value="🌙" />
        </Style>
    </Application.Styles>
</Application>