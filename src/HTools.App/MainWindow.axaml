<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="680"
        x:Class="HTools.App.MainWindow"
        x:Name="RootWindow"
        Width="1040" Height="680"
        MinWidth="640" MinHeight="420"
        Icon="avares://HTools.App/Assets/app.ico"
        Title="{Binding AppTitle}"
        Topmost="{Binding IsAlwaysOnTop}"
        WindowDecorations="None">

    <!-- Everything lives in one Panel so the resize-handle strips (added after, so they paint on top)
         can overlay the thin edges of the real content underneath them. SystemDecorations="None" means
         there is no native window frame at all — no chrome to fight for space with our custom title-bar
         buttons, but also no OS-provided edge/corner resize, which the handles below replace.

         Critical: with no native chrome, nothing implicitly paints the window opaque anymore (that used
         to be the OS frame's job) — the outer Border below MUST have an explicit Background, or the
         window renders as a transparent/blank rectangle, which is exactly what happened before this
         Background was added: the app "opened" but showed nothing. -->
    <Panel>
        <Border Background="{DynamicResource SystemChromeLowColor}"
                BorderBrush="{DynamicResource SystemChromeMediumColor}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <!-- Custom title bar: replaces the native one so a Pin (always-on-top) button can sit
                     directly left of Minimize, which native OS window chrome has no way to accommodate. -->
                <Grid Grid.Row="0" x:Name="TitleBar" Height="36"
                      Background="{DynamicResource SystemChromeLowColor}"
                      PointerPressed="OnTitleBarPointerPressed"
                      ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" IsHitTestVisible="False">
                        <TextBlock Text="{Binding AppTitle}" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ToggleButton x:Name="PinButton" Classes="titleBarButton"
                                      IsChecked="{Binding IsAlwaysOnTop}"
                                      ToolTip.Tip="{Binding PinTooltip}">
                            <TextBlock Text="📌" FontSize="12" />
                        </ToggleButton>
                        <Button Classes="titleBarButton" Click="OnMinimizeClick" ToolTip.Tip="{Binding MinimizeTooltip}">
                            <TextBlock Text="─" FontSize="12" />
                        </Button>
                        <Button x:Name="MaximizeButton" Classes="titleBarButton" Click="OnMaximizeRestoreClick" ToolTip.Tip="{Binding MaximizeTooltip}">
                            <TextBlock x:Name="MaximizeGlyph" Text="🗖" FontSize="12" />
                        </Button>
                        <Button Classes="titleBarButton closeButton" Click="OnCloseClick" ToolTip.Tip="{Binding CloseTooltip}">
                            <TextBlock Text="✕" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="220,*">
                    <!-- Sidebar -->
                    <Border Grid.Column="0" Background="{DynamicResource SystemChromeLowColor}" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{Binding AppTitle}"
                                       FontSize="20" FontWeight="Bold"
                                       Margin="8,8,8,20" />

                            <ItemsControl ItemsSource="{Binding NavGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="navItem"
                                                Classes.selected="{Binding IsSelected}"
                                                Command="{Binding #RootWindow.DataContext.SelectGroupCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Icon}" FontSize="16" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                    <!-- Content -->
                    <DockPanel Grid.Column="1" Margin="24">
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    Margin="0,0,0,16"
                                    IsVisible="{Binding ShowBackButton}">
                            <Button Content="←" Command="{Binding GoHomeCommand}" />
                        </StackPanel>

                        <ContentControl Content="{Binding CurrentContent}" />
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Manual resize handles: thin transparent strips along each edge/corner, each calling
             BeginResizeDrag for the matching WindowEdge. SystemDecorations="None" drops all native
             resize behavior along with the rest of the OS chrome, so this replaces it. Corner handles
             are declared after the edge handles so they render on top and win the hit-test at the
             actual corner pixels, where an edge and a corner strip would otherwise overlap. -->
        <Border Width="5" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWestEast" PointerPressed="OnResizeWest" />
        <Border Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" PointerPressed="OnResizeEast" />
        <Border Height="5" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNorthSouth" PointerPressed="OnResizeNorth" />
        <Border Height="5" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNorthSouth" PointerPressed="OnResizeSouth" />
        <Border Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" PointerPressed="OnResizeNorthWest" />
        <Border Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" PointerPressed="OnResizeNorthEast" />
        <Border Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" PointerPressed="OnResizeSouthWest" />
        <Border Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" PointerPressed="OnResizeSouthEast" />
    </Panel>
</Window>
