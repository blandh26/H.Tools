<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="680"
        x:Class="HTools.App.MainWindow"
        x:Name="RootWindow"
        Width="1040" Height="680"
        MinWidth="640" MinHeight="420"
        Icon="avares://HTools.App/Assets/app.ico"
        Title="{Binding AppTitle}"
        Topmost="{Binding IsAlwaysOnTop}"
        WindowDecorations="None"
        TransparencyLevelHint="None"
        Background="{DynamicResource AppPageBackgroundBrush}">

    <!-- A transparent native surface lets the rounded frame reveal the desktop at its corners. The
         frame itself remains explicitly painted so the content area stays opaque and reliable. -->
    <Panel>
        <Border x:Name="WindowFrame"
                Background="{DynamicResource AppPageBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <!-- Custom title bar: replaces the native one so a Pin (always-on-top) button can sit
                     directly left of Minimize, which native OS window chrome has no way to accommodate. -->
                <Grid Grid.Row="0" x:Name="TitleBar" Height="36"
                      Background="{DynamicResource AppSidebarBrush}"
                      PointerPressed="OnTitleBarPointerPressed"
                      ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" IsHitTestVisible="False">
                        <Image Source="avares://HTools.App/Assets/app.ico" Width="20" Height="20"
                               VerticalAlignment="Center" Stretch="Uniform" />
                        <TextBlock Text="{Binding WindowHeader}" VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ToggleButton x:Name="PinButton" Classes="titleBarButton"
                                      IsChecked="{Binding IsAlwaysOnTop}"
                                      ToolTip.Tip="{Binding PinTooltip}">
                            <TextBlock Classes="titleBarIcon" Text="&#xE718;" />
                        </ToggleButton>
                        <Button Classes="titleBarButton" Click="OnAddToolClick" ToolTip.Tip="{Binding AddToolTooltip}">
                            <TextBlock Classes="titleBarIcon" Text="&#xE710;" />
                        </Button>
                        <Button Classes="titleBarButton" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{Binding SettingsTooltip}">
                            <TextBlock Classes="titleBarIcon" Text="&#xE713;" />
                        </Button>
                        <Button Classes="titleBarButton" Click="OnMinimizeClick" ToolTip.Tip="{Binding MinimizeTooltip}">
                            <TextBlock Text="─" FontSize="12" />
                        </Button>
                        <Button x:Name="MaximizeButton" Classes="titleBarButton" Click="OnMaximizeRestoreClick" ToolTip.Tip="{Binding MaximizeTooltip}">
                            <TextBlock x:Name="MaximizeGlyph" Text="🗖" FontSize="12" />
                        </Button>
                        <Button Classes="titleBarButton closeButton" Click="OnCloseClick" ToolTip.Tip="{Binding CloseTooltip}">
                            <TextBlock Text="✕" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <DockPanel Margin="24">
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    Margin="0,0,0,16"
                                    IsVisible="{Binding ShowBackButton}">
                            <Button Content="←" Command="{Binding GoHomeCommand}" />
                        </StackPanel>

                        <ContentControl Content="{Binding CurrentContent}" />
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Manual resize handles: thin transparent strips along each edge/corner, each calling
             BeginResizeDrag for the matching WindowEdge. WindowDecorations="None" drops all native
             resize behavior along with the rest of the OS chrome, so this replaces it. Corner handles
             are declared after the edge handles so they render on top and win the hit-test at the
             actual corner pixels, where an edge and a corner strip would otherwise overlap. -->
        <Border Width="5" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWestEast" PointerPressed="OnResizeWest" />
        <Border Width="5" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" PointerPressed="OnResizeEast" />
        <Border Height="5" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNorthSouth" PointerPressed="OnResizeNorth" />
        <Border Height="5" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNorthSouth" PointerPressed="OnResizeSouth" />
        <Border Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" PointerPressed="OnResizeNorthWest" />
        <Border Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" PointerPressed="OnResizeNorthEast" />
        <Border Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" PointerPressed="OnResizeSouthWest" />
        <Border Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" PointerPressed="OnResizeSouthEast" />
    </Panel>
</Window>
