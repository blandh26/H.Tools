<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="680"
        x:Class="HTools.App.MainWindow"
        x:Name="RootWindow"
        Width="1040" Height="680"
        MinWidth="640" MinHeight="420"
        Icon="avares://HTools.App/Assets/app.ico"
        Title="{Binding AppTitle}"
        Topmost="{Binding IsAlwaysOnTop}">

    <!-- Back to native window chrome (minimize/maximize/close, resize, drag) after a custom
         WindowDecorations="None" title bar twice rendered a fully blank window and couldn't be
         verified visually in this environment — not worth the risk. The "pin to top" toggle that
         custom bar existed for now lives in the sidebar header instead of next to Minimize. -->
    <Grid ColumnDefinitions="220,*">
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SystemChromeLowColor}" Padding="12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="8,8,8,20">
                    <TextBlock Grid.Column="0"
                               Text="{Binding AppTitle}"
                               FontSize="20" FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="1" Classes="pinToggle"
                                  IsChecked="{Binding IsAlwaysOnTop}"
                                  ToolTip.Tip="{Binding PinTooltip}">
                        <TextBlock Text="📌" FontSize="14" />
                    </ToggleButton>
                </Grid>

                <ItemsControl ItemsSource="{Binding NavGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="navItem"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding #RootWindow.DataContext.SelectGroupCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Icon}" FontSize="16" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Content -->
        <DockPanel Grid.Column="1" Margin="24">
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Spacing="10"
                        Margin="0,0,0,16"
                        IsVisible="{Binding ShowBackButton}">
                <Button Content="←" Command="{Binding GoHomeCommand}" />
            </StackPanel>

            <ContentControl Content="{Binding CurrentContent}" />
        </DockPanel>
    </Grid>
</Window>
